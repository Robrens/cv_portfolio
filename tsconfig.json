{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "strict": true,
    "allowJs": false,
    "isolatedModules": true,

    "esModuleInterop": true,
    "skipLibCheck": true,

    "noEmit": true
  },

  "include": ["resources/js/**/*.ts", "resources/js/**/*.d.ts"]
}
