{
  "$schema": "https://www.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.3.1",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "lint": "eslint resources/js --max-warnings=0",
    "lint:fix": "eslint resources/js --fix",
    "format": "prettier \"resources/**/*.{js,ts,css,scss}\" \"*.{json,yml,yaml}\" \".github/**/*.{yml,yaml}\" --write",
    "format:check": "prettier \"resources/**/*.{js,ts,css,scss}\" \"*.{json,yml,yaml}\" \".github/**/*.{yml,yaml}\" --check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "@types/alpinejs": "^3.13.11",
    "@types/node": "^26.1.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "concurrently": "^10.0.4",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.8.0",
    "laravel-vite-plugin": "^3.1.3",
    "prettier": "^3.9.6",
    "prettier-plugin-css-order": "^2.2.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sass-embedded": "^1.100.0",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5"
  },
  "dependencies": {
    "@heroicons/vue": "^2.2.0",
    "alpinejs": "^3.15.12"
  }
}
